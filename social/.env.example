# Social pipeline configuration: names only, never real values.
# GitHub Actions: repository Settings > Secrets and variables > Actions.
# Vercel: Project Settings > Environment Variables (webhook only).
# See social/SETUP.md for where each value comes from.

# --- GitHub Actions variables (not secret) ---
DRY_RUN=true                  # set to false to go live
SOCIAL_TIMEZONE=America/New_York
TIKTOK_AUDITED=false          # true only after TikTok approves the app
TIKTOK_PULL_FROM_URL=false    # true after rentwithheldy.com is verified in the TikTok portal
GBP_ENABLED=false             # true only after Google approves API access
SOCIAL_MEDIA_BASE_URL=        # optional; defaults to https://rentwithheldy.com
META_GRAPH_VERSION=           # optional; defaults to v26.0

# --- GitHub Actions secrets ---
SUPABASE_URL=
SUPABASE_SECRET_KEY=          # or SUPABASE_SERVICE_ROLE_KEY (server-side only)
META_APP_ID=
META_APP_SECRET=
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
IG_USER_ID=
IG_ACCESS_TOKEN=              # optional; the Page token is used when empty
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=
GBP_CLIENT_ID=
GBP_CLIENT_SECRET=
GBP_REFRESH_TOKEN=
GBP_ACCOUNT_ID=
GBP_LOCATION_ID=
RESEND_API_KEY=               # optional failure alerts
RESEND_FROM_EMAIL=            # optional; a sender on a Resend-verified domain
ALERT_EMAIL=                  # optional failure alerts

# --- Vercel (webhook: /api/meta-webhook) ---
# SUPABASE_URL and SUPABASE_SECRET_KEY are already set for the site's other functions.
META_WEBHOOK_VERIFY_TOKEN=
# META_APP_SECRET=            # also needed in Vercel for the signature check
